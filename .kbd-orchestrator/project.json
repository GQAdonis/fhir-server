{
  "name": "WSO2 FHIR Server",
  "description": "Open-source FHIR R4 REST server written in Go and backed by PostgreSQL.",
  "activePhase": "agent-team-hardening",
  "worktreeRoot": "${HOME}/.claude/worktrees",
  "maxChildDepth": 4,
  "ux_profile": "advanced",
  "__ux_profile_note": "advanced → kbd-status is dense by default; beginner → kbd-status --explain is on by default (expands decision-log entries + next-and-why narrative). Verbosity only — never gates information.",
  "spec_paths": [
    "openspec/specs/**/*.md"
  ],
  "openspec_available": true,
  "constraint_file": ".kbd-orchestrator/constraints.md",
  "build_health_command": "make build && make vet",
  "test_command": "make test",
  "lint_command": "make lint",
  "preferred_planning_agent": "claude-code",
  "preferred_execution_agents": [
    "claude-code",
    "codex",
    "opencode",
    "kimi-code",
    "minimax-code"
  ],
  "model_policy": {
    "registry": {
      "small": {
        "local": "claude-haiku-4-5-20251001",
        "t4": "Qwen3.5-9B-Q8_0",
        "l4": "Qwen3.5-9B-Q8_0"
      },
      "medium": {
        "local": "claude-sonnet-5",
        "t4": "Qwen3.5-27B-Q4",
        "l4": "Qwen3.5-35B-A3B-Q4"
      },
      "frontier": {
        "local": "claude-opus-5-5",
        "t4": "claude-opus-5-5",
        "l4": "claude-opus-5-5"
      }
    },
    "phases": {
      "kbd-assess": "frontier",
      "kbd-plan": "frontier",
      "kbd-status": "small",
      "kbd-reflect": "frontier",
      "opsx-new": "small",
      "opsx-apply-low": "small",
      "opsx-apply-medium": "medium",
      "opsx-apply-high": "frontier",
      "opsx-verify": "medium",
      "opsx-archive": "small",
      "refiner-iterate": "small",
      "refiner-evaluate": "medium",
      "evolver-assess": "frontier",
      "evolver-analyze": "frontier",
      "evolver-plan": "frontier",
      "evolver-execute-low": "small",
      "evolver-execute-medium": "medium",
      "evolver-execute-high": "frontier",
      "evolver-reflect": "frontier",
      "evolver-status": "small",
      "creator-specify": "frontier",
      "creator-plan": "frontier",
      "creator-execute": "tiered",
      "creator-reflect": "frontier",
      "creator-persist": "small"
    },
    "active_environment": "local",
    "__registry_note": "local lane = Claude Code agent team (docs/agent-team.md): small=Haiku 4.5 (no role assigned since knowledge curation merged into fhir-tech-lead, ATH-D-002), medium=Sonnet 5 (go-developer/test/code-review/validate/infra/ehr-integration-manager/data-sync-coordinator), frontier=Opus 5.5 (tech-lead/architect/storage-search/security/hipaa-privacy-officer/fhir-integration-specialist/billing-prior-auth-specialist). Team source: .agent-team/team.json. t4/l4 are self-hosted GPU lanes and keep their open-weight models for small/medium."
  },
  "agents_config": {
    "antigravity": {
      "entry": "SKILL.md slash commands",
      "strengths": [
        "multi-file features",
        "browser verification",
        "planning"
      ]
    },
    "roo-code": {
      "entry": "Roo Code mode in VSCode",
      "strengths": [
        "focused implementation",
        "architect decisions"
      ]
    },
    "cursor-agent": {
      "entry": "Cursor Agent mode",
      "strengths": [
        "parallel subagent tasks",
        "refactoring"
      ]
    },
    "codex": {
      "entry": "OpenAI Codex CLI / app (agents: .codex/agents/*.toml, registered in .codex/config.toml; trust the project first)",
      "team_target": "codex",
      "strengths": [
        "parallel isolated tasks via git worktrees"
      ],
      "roster_doc": "docs/agent-team.md"
    },
    "cline": {
      "entry": "Cline VSCode extension",
      "strengths": [
        "terminal-first workflows",
        "Plan/Act mode"
      ]
    },
    "opencode": {
      "entry": "OpenCode CLI (agents: .opencode/agents/*.md)",
      "team_target": "opencode",
      "strengths": [
        "quick targeted edits",
        "file patches"
      ],
      "roster_doc": "docs/agent-team.md"
    },
    "claude-code": {
      "entry": "claude --agent fhir-tech-lead (agents: .claude/agents/*.md)",
      "team_target": "claude",
      "strengths": [
        "KBD orchestration via fhir-tech-lead",
        "persona-routed implementation, review and validation",
        "cross-platform Karpathy logging hooks"
      ],
      "roster_doc": "docs/agent-team.md"
    },
    "kimi-code": {
      "entry": "kimi -m kimi-code/k3 --agent <id> (agents: .kimi-code/agents/*.md; per-agent model ignored)",
      "team_target": "kimi",
      "strengths": [
        "headless role runs with a session-chosen model"
      ],
      "roster_doc": "docs/agent-team.md"
    },
    "minimax-code": {
      "entry": "MINIMAX_DATA_DIR=.minimax mcode, agent picked interactively (agents: .minimax/agents/<id>/agent.md; mcode exec has no agent selector)",
      "team_target": "minimax",
      "strengths": [
        "interactive role sessions"
      ],
      "roster_doc": "docs/agent-team.md"
    }
  },
  "focus_project_path": "/Users/gqadonis/Projects/TribeHealth/fhir-server",
  "dev_command": "make run",
  "workspace": {
    "workspace_file": null,
    "folders": [
      {
        "path": "/Users/gqadonis/Projects/TribeHealth/fhir-server",
        "role": "focus",
        "purpose": "Active project — all KBD operations target this directory",
        "write_access": true
      }
    ]
  },
  "integration_test_command": "make test-integration",
  "conformance_test_command": "make test-conformance",
  "updatedAt": "2026-09-26T22:07:15Z",
  "__agents_note": "The five team harnesses (claude-code, codex, opencode, kimi-code, minimax-code) run the same 14 roles generated from .agent-team/team.json (team_target = its native target id). Cloud-model harnesses are synthetic-data only; Tribe PHI lanes are Claude first, then Codex and OpenCode; Kimi and MiniMax are not approved (docs/compliance/README.md)."
}
