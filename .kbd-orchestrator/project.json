        "local": "claude-haiku-4-5-20251001",
        "t4": "Qwen3.5-9B-Q8_0",
        "l4": "Qwen3.5-9B-Q8_0"
      },
      "medium": {
        "local": "claude-sonnet-5",
        "t4": "Qwen3.5-27B-Q4",
        "l4": "Qwen3.5-35B-A3B-Q4"
      },
      "frontier": {
        "local": "claude-opus-5-5",
