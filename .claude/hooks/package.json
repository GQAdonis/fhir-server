{
  "name": "fhir-server-claude-hooks",
  "private": true,
  "description": "Cross-platform Claude Code hooks for the WSO2 FHIR Server agent team (TypeScript 7 -> Node .mjs).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
