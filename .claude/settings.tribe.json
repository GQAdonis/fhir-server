{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Tribe-lane profile for Claude Code (change configure-phi-lanes, task 4.1). Load it explicitly (`claude --settings .claude/settings.tribe.json`) for a real PHI session; it is not loaded by default. It duplicates the hooks block of .claude/settings.json minus the Karpathy Stop/SessionEnd/PreCompact hooks (they write session-note text, an off-lane sink) and adds denies for off-lane channels. Keep the guard/ledger hook entries here in sync with .claude/settings.json by hand; there is no supported partial-merge between settings files. Some fields below (extraKnownMarketplaces as the only documented plugin-marketplace control, cleanupPeriodDays for transcript retention) are best-effort against the public Claude Code settings reference and have not been verified end to end in this repo's CI; verify against your installed Claude Code version before relying on this file for a real Tribe session.",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "cleanupPeriodDays": 1,
  "permissions": {
    "deny": ["WebFetch", "WebSearch", "mcp__*"]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-ledger.mjs"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-scope-guard.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-ledger.mjs"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-scope-guard.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-ledger.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-ledger.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-ledger.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/session-context.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/guard-generated.mjs"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/agent-scope-guard.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/phi-lane-guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/license-header.mjs"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dist/gofmt-check.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {}
}
